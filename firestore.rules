rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connectivity probe
    match /test/{testId} {
      allow read, write: if true;
    }

    // Global app state sync (allows Express backend and multi-device clients to read/write persistent state)
    match /app_state/{docId} {
      allow read, write: if true;
    }

    // Public competition config, settings, zones, events, team members
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /zones/{docId} {
      allow read, write: if true;
    }
    match /events/{docId} {
      allow read, write: if true;
    }
    match /teamMembers/{docId} {
      allow read, write: if true;
    }
    match /team_members/{docId} {
      allow read, write: if true;
    }

    // Registrations, users, contact inquiries, audit logs
    match /users/{userId} {
      allow read, write: if true;
    }
    match /registrations/{regId} {
      allow read, write: if true;
    }
    match /contactMessages/{msgId} {
      allow read, write: if true;
    }
    match /emailLogs/{logId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
